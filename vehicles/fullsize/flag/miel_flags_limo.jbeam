        ["flg3r", "flg5r"],
        ["flg4r", "flg7r"],
        ["flg5r", "flp2r"],
        ["flg5r", "flp3r"],
        ["flg6r", "flg7r"],

        //flagpole attach
        {"beamSpring":51000,"beamDamp":15},
        {"beamDeform":2000,"beamStrength":2000},
        {"breakGroup":"flag_R"},
        ["flp1r", "fe4r"],
        ["flp1r", "fe8r"],
