        ["flp4r", "flp5r"],

        //flag main shape
        {"beamSpring":1000,"beamDamp":0.10},
        {"beamDeform":1000,"beamStrength":1000},
        {"deformLimitExpansion":1.1},
        //vert
        ["flg1r", "flg2r"],
        ["flg2r", "flg3r"],
        ["flg4r", "flg5r"],
        ["flg5r", "flg6r"],
        ["flp2r", "flg7r"],
        ["flg7r", "flp3r"],
        //length
        ["flg1r", "flg4r"],
        ["flg4r", "flp2r"],
        ["flg2r", "flg5r"],
        ["flg5r", "flg7r"],
        ["flg3r", "flg6r"],
