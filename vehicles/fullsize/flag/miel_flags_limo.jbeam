        //flagpole main shape
        {"beamSpring":201000,"beamDamp":60},
        {"beamDeform":20000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":1.2},
        ["flp1r", "flp2r"],
        ["flp2r", "flp3r"],

