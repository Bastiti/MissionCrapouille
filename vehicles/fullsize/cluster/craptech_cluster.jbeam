{
"craptech_fullsize_dash": {
    "information":{
        "authors":"BeamNG, Crapouille Technologies",
        "name":"Dashboard (Crapouille Digital Cluster)",
        "value":2400,
    },
    "slotType" : "fullsize_dash",
    //  The analog gauges give way to a full digital cluster: one screen fills the cluster's opening (speedometer,
    //  tachometer with the gear, coolant and fuel, warning lights, and in the middle a map, the trip computer or
    //  the engine's readings). A click on the screen shows the next of those; a middle click resets the trip.
    //  It lights up with the ignition (the clock and odometer from the accessory position on).
    //  Generated by gen_cluster.py from the stock part.
    "controller": [
        ["fileName"],
        ["craptechCluster", {"htmlPath":"local://local/vehicles/fullsize/cluster/craptech_cluster.html", "webView":"@craptech_cluster", "screenMaterials":["craptech_dcl_night", "craptech_dcl_day"],
                             "textureWidth":1280, "textureHeight":364, "textureFPS":60, "hideProps":["fullsize_needle_gear"]}],
    ],
    "glowMap":{
        "craptech_dcl_face": {"simpleFunction":"craptech_cluster_lit", "off":"craptech_dcl_glass", "on":"craptech_dcl_night", "on_intense":"craptech_dcl_day"},
    },
    "slots2": [
        ["name",                    "allowTypes",                "denyTypes", "default",            "description"],
        ["fullsize_sunvisors",      ["fullsize_sunvisors"],      [],          "fullsize_sunvisors", "Sunvisors"],
        ["fullsize_shifter",        ["fullsize_shifter"],        [],          "fullsize_shifter_A", "Shifter"],
        ["fullsize_steer",          ["fullsize_steer"],          [],          "fullsize_steer",     "Steering Wheel"],
        ["fullsize_dash_accessory", ["fullsize_dash_accessory"], [],          "",                   "Interior Accessory"],
        ["fullsize_seat_FL",        ["fullsize_seat_FL"],        [],          "fullsize_seat_FL",   "Driver Seat", {"variables":{"$isDriver":"LHD"}}],
        ["fullsize_seat_FR",        ["fullsize_seat_FR"],        [],          "fullsize_seat_FR",   "Passenger Seat"],
    ],
    "props": [
        ["func",         "mesh",                   "idRef:", "idX:", "idY:", "baseRotation",            "rotation",                 "translation",         "min", "max", "offset", "multiplier"],
        //pedals
        ["brake",        "fullsize_brakepedal",    "b1l","b1r","b5l",        {"x":8, "y":0, "z":180},   {"x":-25, "y":0, "z":0},    {"x":0, "y":0, "z":0}, 0, 1, 0, 1],
        ["throttle",     "fullsize_gaspedal",      "b1l","b1r","b5l",        {"x":0, "y":0, "z":180},   {"x":-20, "y":0, "z":0},    {"x":0, "y":0, "z":0}, 0, 1, 0, 1],
        ["parkingbrake", "fullsize_parkingbrake",  "b1l","b1r","b5l",        {"x":0, "y":0, "z":180},   {"x":-22, "y":0, "z":0},    {"x":0, "y":0, "z":0}, 0, 1, 0, 1],
        //turn signal stalk
        ["turnsignal",   "fullsize_signalstalk",  "dsh2l","dshl","int_strw", {"x":0, "y":-10, "z":10}, {"x":0, "y":0, "z":-15},  {"x":0, "y":0, "z":0}, -1, 1, 0, 1],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //interior
        ["fullsize_dash", ["fullsize_dashboard"]],
        //the digital cluster: the page (craptechCluster) on a screen in the stock face's place
        ["craptech_cluster_screen", ["fullsize_dashboard"]],
    ],
    "triggers2":[
      ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
      ["headlights",  "dsh","dshl","dsh2","sphere", 0.025,                   {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.616, "y":0.058, "z": 0.000}, {"color":[1, 0.5, 0, 1]}],
      ["hazard",      "dsh","dshl","dsh2","box",{"x":0.02,"y":0.01,"z":0.02},{"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.550, "y":0.065, "z":-0.010}, {"color":[1, 0.5, 0, 1]}],
      ["sw_ignition", "dsh","dshl","dsh2","sphere", 0.025,                   {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.350, "y":0.058, "z":-0.095}, {"color":[1, 0.5, 0, 1]}],
      ["craptech_cluster", "dsh","dshl","dsh2", "box", {"x":0.3508, "y":0.0160, "z":0.0856}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},
          {"baseTranslationGlobal":{"x":0.2371, "y":-0.5678, "z":1.0212}, "mesh":"craptech_cluster_screen"}],
      ["parkingBrake","b5ll","b5l","b2ll","box",{"x":0.11,"y":0.12,"z":0.08},{"x":10,"y":8, "z":5}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.080, "y":0.050, "z":-0.030}, {"mesh":"fullsize_parkingbrake"}],
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["headlights", "action0", "common:toggle_headlights"],
        ["hazard", "action0", "common:toggle_hazard_signal"],
        ["sw_ignition", "action0", "common:activateStarterMotor"],
        ["sw_ignition", "action2", "common:setIgnitionLevel3Momentary"],
        ["parkingBrake","action0", "common:parkingbrake_toggle"],
        ["craptech_cluster", "action0", "craptech_cluster_page"],
        ["craptech_cluster", "action2", "craptech_cluster_trip"],
    ],
    "actionsEnabled": [
        ["id"],
        ["craptech_cluster_page"],
        ["craptech_cluster_trip"],
    ],
}
}
