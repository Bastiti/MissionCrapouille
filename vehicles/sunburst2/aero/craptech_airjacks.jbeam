{
"craptech_airjacks": {
    "information":{
        "authors":"Crapouille Technologies",
        "name":"Crapouille Air Jacks",
        "value":1800,
    },
    //  Pit-style air jacks: four feet tucked under the floor rails (just behind the front
    //  wheels and just ahead of the rear ones). Each foot is pushed straight down by four
    //  hydros to spread chassis nodes, so it can only move vertically; 42 cm of stroke lifts
    //  the car until the wheels hang free.
    //
    //  Toggle: Controls > Vehicle Specific > "Toggle air jacks", or the radial menu.
    //  Needs power (ignition at least accessories) and the car stopped to extend.
    //  Logic: lua/controller/craptechAirJacks.lua. Rows generated, all options inline:
    //  jbeam modifier rows would leak into other parts' sections (e.g. the steering hydros).
    "slotType" : "craptech_airjacks",
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        ["aj_fl", 0.365, -1.015, 0.170, {"nodeWeight":3.0,"collision":true,"selfCollision":false,"nodeMaterial":"|NM_METAL","frictionCoef":1.2,"group":""}],
