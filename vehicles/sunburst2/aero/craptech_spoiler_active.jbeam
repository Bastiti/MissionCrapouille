          //attach: the spoiler is not bolted to the lid. It stands on its four fin feet, each
          //held by four lift hydros to the body (see "hydros"), so it can sink inside the trunk
          //while the reverse-hinged lid is open. These spring-free dampers only calm it; they
          //never resist the lift.
          ["sp5rr", "q3r", {"beamSpring":0,"beamDamp":60,"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX","beamPrecompression":1,"beamType":"|NORMAL","deformGroup":"","breakGroup":"spoiler_attach_r"}],
