{
"craptech_spoiler_sedan_rs_active": {
    "information":{
        "authors":"Crapouille Technologies",
        "name":"Crapouille Sport RS Active Spoiler (Taxi Mode)",
        "value":2400,
    },
    //  The stock Sport RS spoiler at its full stock width (1.38 m), telescoping: the stock wing
    //  is 22 cm wider than the trunk opening, so for the trip in and out of the trunk the two end
    //  plates (with the outer main-plane and blade sections, built as sleeves a few mm oversize)
    //  slide 14 cm inward, Porsche-Panamera style, and the wing passes the opening at 1.10 m.
    //  They slide while the wing hovers and the lid swings; on the lid the wing is stock width.
    //
    //  Two hydraulic struts, pivoting at the rear-glass / lid seam, hold the wing all the way
    //  (barrel and rod are props on node triads: P = spsp_*, the wing end T = spst_*, so they
    //  always aim at each other and telescope with the real wing position).
    //
    //  Physics are unchanged from the 80 % version: the sp* nodes below are the narrow wing,
    //  with aero coefficients scaled by 1/0.8 so it makes the full-width wing's forces.
    //
    //  The blade (sp1*/sp2* nodes) is cut loose from the uprights everywhere except its two
    //  outer leading-edge nodes sp1rr/sp1ll, which become the hinge. The trailing edge is held
    //  by one hydro per side (sp2rr-sp4rr, sp2ll-sp4ll), so the hydro length sets the blade
    //  angle. The lift triangles ride on those nodes, so the angle really changes the downforce
    //  and drag: past ~17 deg (stallAngle 0.3) the blade stalls and acts as an airbrake.
    //
    //  craptech_aero_wing (set by lua/controller/craptechActiveAero.lua):
    //      -1 -> -6 deg (stowed / low drag)   0 -> stock angle   +1 -> +25 deg (airbrake)
    "slotType" : "sunburst2_spoiler_sedan",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //  Full-width stock mesh cut up (aero/craptech_spoiler.dae): the centre of the top blade
         //  follows only the moving blade nodes; the centre of the main plane follows the fixed
         //  nodes. The sliding outer parts are props (see "props").
         ["craptech_spoiler_blade", ["craptech_spoiler_blade"]],
         ["craptech_spoiler_fixed", ["sunburst2_spoiler"]],
    ],
    //  craptech_wing_narrow (craptechActiveAero.lua): 0 = stock width, 1 = narrow for the trunk.
    //  End assemblies slide along the main plane's leading edge, tip sleeves along the blade's;
    //  both directions were fitted on the mesh so the centre parts stay inside the sleeves.
    "props": [
        ["func", "mesh", "idRef:", "idX:", "idY:", "baseRotation", "rotation", "translation", "min", "max", "offset", "multiplier"],
        ["craptech_wing_narrow", "craptech_spoiler_end_l", "sp3rr", "sp3ll", "sp4rr", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0, "y":0, "z":0}, "baseRotationGlobal":{"x":0, "y":0, "z":0}, "translationGlobal":{"x":-0.14, "y":0.030, "z":-0.009}, "breakGroup":"spoiler_attach_l"}],
        ["craptech_wing_narrow", "craptech_spoiler_end_r", "sp3rr", "sp3ll", "sp4rr", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0, "y":0, "z":0}, "baseRotationGlobal":{"x":0, "y":0, "z":0}, "translationGlobal":{"x":0.14, "y":0.030, "z":-0.009}, "breakGroup":"spoiler_attach_r"}],
        ["craptech_wing_narrow", "craptech_spoiler_tip_l", "sp1rr", "sp1ll", "sp2rr", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0, "y":0, "z":0}, "baseRotationGlobal":{"x":0, "y":0, "z":0}, "translationGlobal":{"x":-0.14, "y":0.030, "z":0.004}, "breakGroup":"spoiler_attach_l"}],
        ["craptech_wing_narrow", "craptech_spoiler_tip_r", "sp1rr", "sp1ll", "sp2rr", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0, "y":0, "z":0}, "baseRotationGlobal":{"x":0, "y":0, "z":0}, "translationGlobal":{"x":0.14, "y":0.030, "z":0.004}, "breakGroup":"spoiler_attach_r"}],
        //  struts: barrel on (pivot, pivot+x, wing end), rod on (wing end, wing end+x, pivot)
        ["craptech_static", "craptech_strut_barrel_l", "spsp_l", "spsq_l", "spst_l", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0.25, "y":1.600, "z":0.955}, "baseRotationGlobal":{"x":0, "y":0, "z":0}}],
        ["craptech_static", "craptech_strut_rod_l", "spst_l", "spsx_l", "spsp_l", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0.25, "y":2.02, "z":0.99}, "baseRotationGlobal":{"x":0, "y":0, "z":0}}],
        ["craptech_static", "craptech_strut_barrel_r", "spsp_r", "spsq_r", "spst_r", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":-0.25, "y":1.600, "z":0.955}, "baseRotationGlobal":{"x":0, "y":0, "z":0}}],
        ["craptech_static", "craptech_strut_rod_r", "spst_r", "spsx_r", "spsp_r", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":-0.25, "y":2.02, "z":0.99}, "baseRotationGlobal":{"x":0, "y":0, "z":0}}],
        ["craptech_static", "craptech_strut_mount_l", "spsp_l", "spsq_l", "tb2l", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0.25, "y":1.600, "z":0.955}, "baseRotationGlobal":{"x":0, "y":0, "z":0}}],
        ["craptech_static", "craptech_strut_mount_r", "spsp_r", "spsq_r", "tb2r", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":-0.25, "y":1.600, "z":0.955}, "baseRotationGlobal":{"x":0, "y":0, "z":0}}],
        ["craptech_static", "craptech_strut_tab_l", "sp3rr", "sp3ll", "sp4rr", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0.25, "y":2.02, "z":0.99}, "baseRotationGlobal":{"x":0, "y":0, "z":0}}],
        ["craptech_static", "craptech_strut_tab_r", "sp3rr", "sp3ll", "sp4rr", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":-0.25, "y":2.02, "z":0.99}, "baseRotationGlobal":{"x":0, "y":0, "z":0}}],
    ],
    //  the lid opens (2 s, craptech_trunk_reverse.jbeam), the wing rises out of the trunk in 4 s (its end
    //  plates sliding out over 1.6 s from 25 cm above the lid line on), the lid shuts under it (2 s), the
    //  wing lands in 2 s: 10 s in all, each way
    "controller": [
        ["fileName"],
        ["craptechActiveAero", {"wingElectric": "craptech_aero_wing", "stowY": -0.1, "sinkDepth": 0.39, "hoverHeight": 0.45, "riseTime": 4.0, "landTime": 2.0, "narrowTime": 1.6, "liftHydros": [["craptech_lift_1", -0.712, 1.758, 0.905, -0.5104, 1.701, 0.99, 0.22609, 0.998, 2.62436], ["craptech_lift_2", -0.835, 1.4, 0.661, -0.5104, 1.701, 0.99, 0.55155, 0.69028, 1.57489], ["craptech_lift_3", 0.0, 2.098, 0.37, -0.5104, 1.701, 0.99, 0.895833, 0.83366, 1.43694], ["craptech_lift_4", -0.269, 1.266, 0.922, -0.5104, 1.701, 0.99, 0.502118, 0.82035, 1.32129], ["craptech_lift_5", -0.601, 1.98, 0.923, -0.4504, 1.987, 0.955, 0.154121, 0.998, 3.33362], ["craptech_lift_6", -0.835, 1.4, 0.661, -0.4504, 1.987, 0.955, 0.760869, 0.81359, 1.27531], ["craptech_lift_7", 0.0, 2.098, 0.37, -0.4504, 1.987, 0.955, 0.746596, 0.71356, 1.54006], ["craptech_lift_8", -0.252, 1.575, 0.981, -0.4504, 1.987, 0.955, 0.45802, 0.8053, 1.23026], ["craptech_lift_9", 0.713, 1.758, 0.905, 0.5104, 1.701, 0.99, 0.226982, 0.998, 2.61555], ["craptech_lift_10", 0.835, 1.4, 0.661, 0.5104, 1.701, 0.99, 0.55155, 0.69028, 1.57489], ["craptech_lift_11", 0.0, 2.098, 0.37, 0.5104, 1.701, 0.99, 0.895833, 0.83366, 1.43694], ["craptech_lift_12", 0.269, 1.266, 0.922, 0.5104, 1.701, 0.99, 0.502118, 0.82035, 1.32129], ["craptech_lift_13", 0.601, 1.98, 0.923, 0.4256, 1.987, 0.955, 0.178433, 0.998, 2.92346], ["craptech_lift_14", 0.835, 1.4, 0.661, 0.4256, 1.987, 0.955, 0.773701, 0.82031, 1.26726], ["craptech_lift_15", 0.0, 2.098, 0.37, 0.4256, 1.987, 0.955, 0.731903, 0.69959, 1.55795], ["craptech_lift_16", 0.252, 1.575, 0.981, 0.4256, 1.987, 0.955, 0.447836, 0.79532, 1.23975]]}],
    ],
    "nodes": [
         ["id",    "posX", "posY", "posZ"],
         {"nodeMaterial":"|NM_PLASTIC"},
         {"frictionCoef":0.5},
         {"collision":true},
         //it travels in and out of the trunk, so it never collides with the car itself
         //(its triangles are NONCOLLIDABLE as well, see "triangles")
         {"selfCollision":false},

         {"group":"sunburst2_spoiler"},
         {"nodeWeight":0.45},
         //hinge nodes sit on the pivot axis, so both meshes may use them
         ["sp1rr",-0.4936,  1.851,  1.204, {"group":["sunburst2_spoiler","craptech_spoiler_blade"]}],
         ["sp1r", -0.2840,  1.900,  1.164, {"group":"craptech_spoiler_blade"}],
