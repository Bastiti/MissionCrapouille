    "hydros": [
        ["id1:", "id2:"],
        //  Every option is inline on purpose: hydros sections of all parts are merged, and
        //  modifier rows here would carry over into the steering hydros that follow.
        //  Length ratios from the hinge geometry (-6 deg / stock / +25 deg); the stock nodes are
        //  not quite symmetric, so each side has its own limits to keep the blade untwisted.
        ["sp2rr", "sp4rr", {"beamSpring":350000, "beamDamp":200, "beamDeform":"FLT_MAX", "beamStrength":"FLT_MAX",
                            "beamPrecompression":1, "breakGroup":"spoiler_attach_r", "deformGroup":"",
                            "factor":"", "extentFactor":"",
