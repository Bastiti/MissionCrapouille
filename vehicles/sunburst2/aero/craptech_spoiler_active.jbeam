    "triangles": [
        ["id1:",  "id2:",  "id3:"],
        //  Options inline (no modifier rows, which would carry into later parts' triangles).
        //  liftCoef and dragCoef are raised by 1/0.8 so the narrower wing still makes the same
        //  downforce and drag as the full-width one.
        ["sp4rr", "sp3rr", "sp1rr", {"triangleType":"NONCOLLIDABLE", "dragCoef":41, "groundModel":"plastic", "liftCoef":75, "stallAngle":0.3}],
