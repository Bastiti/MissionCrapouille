         ["sp1l",  0.2840,  1.900,  1.164, {"group":"craptech_spoiler_blade"}],
         ["sp1ll", 0.4936,  1.851,  1.204, {"group":["sunburst2_spoiler","craptech_spoiler_blade"]}],

         ["sp2rr",-0.4728,  2.045,  1.242, {"group":"craptech_spoiler_blade"}],
         ["sp2r", -0.2840,  2.058,  1.202, {"group":"craptech_spoiler_blade"}],
         ["sp2",   0.0000,  2.086,  1.216, {"group":"craptech_spoiler_blade"}],
         ["sp2l",  0.2840,  2.058,  1.202, {"group":"craptech_spoiler_blade"}],
         ["sp2ll", 0.4728,  2.045,  1.242, {"group":"craptech_spoiler_blade"}],

         ["sp3rr",-0.5472,  1.701,  1.032],
         ["sp3r", -0.1752,  1.830,  1.017],
         ["sp3l",  0.1752,  1.830,  1.017],
         ["sp3ll", 0.5472,  1.701,  1.032],

         ["sp4rr",-0.5248,  1.957,  1.020],
         ["sp4r", -0.1752,  2.054,  1.027],
         ["sp4l",  0.1752,  2.054,  1.027]
         ["sp4ll", 0.5000,  1.957,  1.020],

         ["sp5rr",-0.5104,  1.701,  0.990],
         ["sp5ll", 0.5104,  1.701,  0.990],

         ["sp6rr",-0.4504,  1.987,  0.955],
         ["sp6ll", 0.4256,  1.987,  0.955]

         {"group":""},
         ["sprg",  0.0000,  1.958,  0.800,  {"nodeWeight":0.9, "selfCollision":false, "collision":false}]
         //blade stiffener: hangs under the blade and moves with it
         ["spbrg", 0.0000,  1.985,  1.100,  {"nodeWeight":0.5, "selfCollision":false, "collision":false, "group":"craptech_spoiler_blade"}]
         //strut ends on the wing (T) and their side references (T + 12 cm in x)
         ["spst_l",  0.25, 2.02, 0.99, {"nodeWeight":1.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
         ["spsx_l",  0.37, 2.02, 0.99, {"nodeWeight":1.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
         ["spst_r", -0.25, 2.02, 0.99, {"nodeWeight":1.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
         ["spsx_r", -0.13, 2.02, 0.99, {"nodeWeight":1.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
         //strut pivots on the body (P, inside the trunk under the lid's front edge) and their side references
         ["spsp_l",  0.25, 1.600, 0.955, {"nodeWeight":1.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
         ["spsq_l",  0.37, 1.600, 0.955, {"nodeWeight":1.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
         ["spsp_r", -0.25, 1.600, 0.955, {"nodeWeight":1.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
         ["spsq_r", -0.13, 1.600, 0.955, {"nodeWeight":1.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
    ],
    "beams": [
          ["id1:",  "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

