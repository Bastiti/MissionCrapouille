                            "inputInLimit":-1, "inputOutLimit":1, "inLimit":0.9292, "outLimit":1.2668,
                            "inRate":0.7, "outRate":0.7, "autoCenterRate":0.7}],
        ["sp2ll", "sp4ll", {"beamSpring":350000, "beamDamp":200, "beamDeform":"FLT_MAX", "beamStrength":"FLT_MAX",
                            "beamPrecompression":1, "breakGroup":"spoiler_attach_l", "deformGroup":"",
