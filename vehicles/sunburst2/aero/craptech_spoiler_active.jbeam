                            "inRate":0.7, "outRate":0.7, "autoCenterRate":0.7}],
        //  inner trailing-edge hydros on the same input: with only the two end ones the middle of the
        //  blade lagged (twisted) and the sliding tip sleeves showed a gap at the joint
        ["sp2r", "sp4r", {"beamSpring":200000, "beamDamp":150, "beamDeform":"FLT_MAX", "beamStrength":"FLT_MAX",
                            "beamPrecompression":1, "breakGroup":"", "deformGroup":"",
