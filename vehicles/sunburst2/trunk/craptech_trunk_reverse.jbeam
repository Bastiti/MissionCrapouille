            {"baseTranslationGlobal":{"x":0.25, "y":1.664, "z":0.9616}, "baseRotationGlobal":{"x":0, "y":0, "z":0}, "translationGlobal":{"x":0, "y":0.15, "z":-0.035}}],
        ["craptech_strut_slot", "craptech_slot_cover_r", "t1r", "t1rr", "t2r", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
