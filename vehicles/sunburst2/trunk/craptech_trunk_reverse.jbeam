         {"deformGroup":"", "deformationTriggerRatio":""},
    ],
    //  Strut slots: the lid mesh has two slim slots at its front edge where the wing struts pass
    //  (their pivots are inside the trunk). A painted strip fills each slot and slides back under
    //  the lid skin while the wing is out: craptech_strut_slot 0 = shut .. 1 = open
    //  (craptechActiveAero.lua). Meshes: hatches/craptech_hatches.dae.
    "props": [
        ["func", "mesh", "idRef:", "idX:", "idY:", "baseRotation", "rotation", "translation", "min", "max", "offset", "multiplier"],
