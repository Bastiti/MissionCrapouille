{
"craptech_seqsignals_led": {
    "information":{
        "authors":"Crapouille Technologies",
        "name":"Crapouille Sequential LED Indicators",
        "value":250
    },
    "slotType" : "craptech_seqsignals",
    //  Every indicator lamp (headlight tips, taillight centres, mirror repeaters) lights up as a
    //  sweep: segmented copies of the stock indicator areas (craptech_seqsignals.dae) glow one after
    //  another, driven by craptechSeqSignal.lua; with hazards both sides sweep. The stock indicator
    //  glow is switched off below (a part's glowMap entries replace the stock ones), so removing
    //  this part gives the stock indicators back. Generated by gen_seqsignals.py.
    "controller": [
        ["fileName"],
        ["craptechSeqSignal", {"name":"seqSignals", "lamps":[["F", 6], ["B", 4], ["M", 5]], "sweepTime":0.2}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["craptech_seqsig_front_L", ["sunburst2_headlight_L"], [], {"deformGroup":"headlightglass_L_break", "deformMaterialBase":"invis", "deformMaterialDamaged":"invis"}],
         ["craptech_seqsig_frontglass_L", ["sunburst2_headlight_L"], [], {"deformGroup":"headlightglass_L_break", "deformMaterialBase":"invis", "deformMaterialDamaged":"invis"}],
         ["craptech_seqsig_rear_L", ["sunburst2_taillight_L"], [], {"deformGroup":"taillightglass_L_break", "deformMaterialBase":"invis", "deformMaterialDamaged":"invis"}],
         ["craptech_seqsig_mirror_L", ["sunburst2_mirror_L"], [], {"deformGroup":"mirrorsignal_L_break", "deformMaterialBase":"invis", "deformMaterialDamaged":"invis"}],
         ["craptech_seqsig_front_R", ["sunburst2_headlight_R"], [], {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"invis", "deformMaterialDamaged":"invis"}],
         ["craptech_seqsig_frontglass_R", ["sunburst2_headlight_R"], [], {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"invis", "deformMaterialDamaged":"invis"}],
         ["craptech_seqsig_rear_R", ["sunburst2_taillight_R"], [], {"deformGroup":"taillightglass_R_break", "deformMaterialBase":"invis", "deformMaterialDamaged":"invis"}],
         ["craptech_seqsig_mirror_R", ["sunburst2_mirror_R"], [], {"deformGroup":"mirrorsignal_R_break", "deformMaterialBase":"invis", "deformMaterialDamaged":"invis"}],
    ],
    "glowMap":{
        // stock indicator areas stay dark, the segments light up in front of them
        "sunburst2_signal_L":       {"simpleFunction":"craptech_seqsig_stock", "off":"sunburst2_lights", "on":"sunburst2_lights_on_intense"},
        "sunburst2_signal_R":       {"simpleFunction":"craptech_seqsig_stock", "off":"sunburst2_lights", "on":"sunburst2_lights_on_intense"},
        "sunburst2_signalglass_L":  {"simpleFunction":"craptech_seqsig_stock", "off":"sunburst2_glass", "on":"sunburst2_glass_on_intense"},
        "sunburst2_signalglass_R":  {"simpleFunction":"craptech_seqsig_stock", "off":"sunburst2_glass", "on":"sunburst2_glass_on_intense"},
        "craptech_seqsig_F_L_1":   {"simpleFunction":"craptech_seqsig_F_L_1", "off":"invis", "on":"sunburst2_lights_on_intense", "materialEmissiveScaling":{"on_max":1}},
        "craptech_seqsig_F_L_2":   {"simpleFunction":"craptech_seqsig_F_L_2", "off":"invis", "on":"sunburst2_lights_on_intense", "materialEmissiveScaling":{"on_max":1}},
        "craptech_seqsig_F_L_3":   {"simpleFunction":"craptech_seqsig_F_L_3", "off":"invis", "on":"sunburst2_lights_on_intense", "materialEmissiveScaling":{"on_max":1}},
