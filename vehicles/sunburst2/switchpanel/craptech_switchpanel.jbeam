{
"craptech_switchpanel_dash": {
    "information":{
        "authors":"Crapouille Technologies",
        "name":"Crapouille Dash Switch Panel",
        "value":450
    },
    "slotType" : "craptech_switchpanel",
    //  A piece of the dash top above the centre vents turns out (the button on the shifter panel, between TC
    //  and C.DIFF, or the key in Controls), turning about its windshield edge, and shows a row of toggle switches,
    //  one per animated part: air jacks, wheels, race kit, wing, JATO, hidden flashers, rear sign. Click a switch
    //  to flip its lever; the light in the lever's tip shows the part is there (blinking while it moves or
    //  waits). The JATO fires from the big red button on the console behind the shifter, lit while the rockets
    //  burn (blinking while it waits for them). The piece is a wedge with the leather on two faces:
    //  turned out, the second one lies flush in the cut. It is cut out of a copy of the dash, which replaces
    //  the stock dash mesh: the config fits a copy of the stock dashboard without it (nothing is faded, a
    //  replay would show it again; stockparts/craptech_stockparts.jbeam). Generated by gen_switchpanel.py.
    "controller": [
        ["fileName"],
        ["craptechSwitchPanel", {"flipTime":1}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["craptech_dash_switchpanel", ["sunburst2_dash"]],
        ["craptech_swpanel_well", ["sunburst2_dash"]],
    ],
