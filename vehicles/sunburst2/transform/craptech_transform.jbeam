{
"craptech_transform_kit": {
    "information":{
        "authors":"Crapouille Technologies",
        "name":"Crapouille Transform (race add-ons out with the wide track)",
        "value":2500
    },
    "slotType" : "craptech_transform",
    //  With the narrow track the race add-ons tuck away, mechanically: the fender flares sink into
    //  the body and come back out as plain panel (tiles round each arch), side skirts fold in, the
    //  splitter slides into the bumper in pieces and rises out of sight (its centre piece stays as the
    //  bumper's lower edge, a lower lip hidden inside the splitter closes the bumper round the corners),
    //  the diffuser fins fold up into the panel and doors slide shut over them (craptechTransform.lua).
    //  The wide track (air jacks button) brings them back out. Looks only, the parts stay fitted.
    //  Made for the custom bumpers, flares and skirts and the "mielskin" livery (props get it by
    //  materialOverride). Generated by gen_transform.py.
    "controller": [
        ["fileName"],
        ["craptechTransform", {"name":"transform", "time":3.0, "pumpNode":"f2r",
                               "groups":[["craptech_xf_skirts", 0.1, 0.5], ["craptech_xf_spl_slide", 0.28, 0.62], ["craptech_xf_spl_lift", 0.62, 0.82],
