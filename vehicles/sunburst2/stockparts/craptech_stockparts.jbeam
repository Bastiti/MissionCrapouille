          ["fff5r",   "fe6r"],
          ["fff1r",   "fe11r"],
          ["fff1r",   "fe10r"],
          ["fff5r",   "fe5r"],
          ["fff6r",   "fe6r"],
          ["fff2r",   "fe6r"],
          ["fff2r",   "fe10r"],
          ["fff1r",   "fe12r"],
          {"breakGroup":"fenderflare_b_FR"},
          ["fff2r",   "fe9r"],
          ["fff2r",   "fe5r"],
          ["fff6r",   "fe5r"],
          ["fff6r",   "fe9r"],
          ["fff7r",   "fe5r"],
          ["fff7r",   "fe9r"],
          ["fff3r",   "fe9r"],
          ["fff3r",   "fe8r"],
          ["fff7r",   "fe12r"],
          ["fff3r",   "fe12r"],
          ["fff6r",   "fe12r"],
          {"breakGroup":"fenderflare_c_FR"},
          ["fff3r",   "fe7r"],
          ["fff4r",   "fe7r"],
          ["fff4r",   "fe3r"],
          ["fff8r",   "fe3r"],
          ["fff8r",   "fe4r"],
          ["fff7r",   "fe4r"],
          ["fff7r",   "fe8r"],
          ["fff8r",   "fe12r"],
          ["fff4r",   "fe12r"],
          {"breakGroup":"fenderflare_FR_supportBeams"},

          //limiter
          {"beamType":"|SUPPORT", "beamLongBound":2},
          {"beamSpring":201000,"beamDamp":30},
          {"beamDeform":9000,"beamStrength":125000},
