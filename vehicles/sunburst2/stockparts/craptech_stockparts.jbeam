        "authors":"BeamNG",
        "name":"Custom Front Right Fender Flare (Crapouille)",
        "value":300,
    },
    "slotType" : "sunburst2_fenderflare_FR_cut",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //  left out (transform: the flare tile props): ["sunburst2_fenderfalre_b_R", ["sunburst2_fenderflare_FR"]],
    ],
    "nodes": [
         ["id",      "posX", "posY", "posZ"],
         {"nodeMaterial":"|NM_PLASTIC"},
         {"frictionCoef":0.5},
         //--FENDER FLARE--
         {"collision":true},
         {"selfCollision":true},
         {"group":"sunburst2_fenderflare_FR"},
         {"nodeWeight":0.3},
         ["fff1r",  -0.784, -1.717,  0.625],
         ["fff2r",  -0.798, -1.454,  0.787],
         ["fff3r",  -0.819, -1.104,  0.794],
         ["fff4r",  -0.816, -0.829,  0.746],
