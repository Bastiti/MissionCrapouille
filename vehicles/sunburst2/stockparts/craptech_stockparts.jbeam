          ["fff5r",   "fff2r"],
          ["fff1r",   "fff6r"],
          ["fff6r",   "fff3r"],
          ["fff7r",   "fff2r"],
          ["fff7r",   "fff4r"],
          ["fff8r",   "fff3r"],
          //rigids
          {"beamDeform":2100,"beamStrength":62500},
          ["fff1r",   "fff3r"],
          ["fff2r",   "fff4r"],
          ["fff5r",   "fff7r"],
          ["fff6r",   "fff8r"],

          //rigidifier
          ["fffrg1r", "fff1r"],
