         {"collision":false},
         {"selfCollision":false},
         ["fffrg1r",-0.654, -1.280,  0.691]
         {"group":""},
    ],
    "beams": [
          ["id1:",    "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //main shape
          {"beamSpring":201000,"beamDamp":20},
          {"beamDeform":11100,"beamStrength":182500},
          {"deformLimitExpansion":1.2},
          ["fff1r",   "fff2r"],
