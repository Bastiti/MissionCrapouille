        ["cj_ar", "r2rr", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_br", "r3rr", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_br", "r6rr", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_br", "r3", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_br", "r6", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_br", "r5rr", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_br", "r2rr", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_cr", "r3rr", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_cr", "r6rr", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_cr", "r3", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_cr", "r6", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_cr", "r5rr", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_cr", "r2rr", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
    ],
    //  each exhaust pushes back along cj_a -> cj_b, so the car is pushed forward (as stock JATO)
    "thrusters": [
        ["id1:", "id2:", "factor", "thrustLimit", "control"],
        ["cj_al", "cj_bl", 6000, 6000, "craptech_jato_thrust"],
        ["cj_ar", "cj_br", 6000, 6000, "craptech_jato_thrust"],
    ],
    "glowMap":{
        "shockdiamonds":       {"simpleFunction":"craptech_jato_flame", "off":"invis", "on":"craptech_jato_flame_glow"},
        "craptech_jato_core":  {"simpleFunction":"craptech_jato_flame", "off":"invis", "on":"craptech_jato_core_on"},
        "craptech_jato_plume": {"simpleFunction":"craptech_jato_flame", "off":"invis", "on":"craptech_jato_plume_on"},
    },
    //  craptech_jato_door 0 shut .. 1 open: each door is two halves that part like lift doors,
    //  the upper one up (and 3.5 cm in, following the skin), the lower one down behind the lip,
    //  so neither leaves the painted area. craptech_jato_out 0 in .. 1 out: rocket and flames 17 cm straight back.
    "props": [
        ["func", "mesh", "idRef:", "idX:", "idY:", "baseRotation", "rotation", "translation", "min", "max", "offset", "multiplier"],
        ["craptech_jato_door", "craptech_jato_door_top_l", "r6ll", "r6", "r3ll", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0.3400, "y":2.2092, "z":0.4745}, "baseRotationGlobal":{"x":0, "y":0, "z":0}, "translationGlobal":{"x":0, "y":-0.035, "z":0.046}, "breakGroup":"craptech_jato_l"}],
        ["craptech_jato_door", "craptech_jato_door_bot_l", "r6ll", "r6", "r3ll", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0.3400, "y":2.2140, "z":0.4295}, "baseRotationGlobal":{"x":0, "y":0, "z":0}, "translationGlobal":{"x":0, "y":-0.010, "z":-0.046}, "breakGroup":"craptech_jato_l"}],
        ["craptech_static", "craptech_jato_aperture_l", "r6ll", "r6", "r3ll", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0.3400, "y":2.2123, "z":0.4520}, "baseRotationGlobal":{"x":0, "y":0, "z":0}, "translationGlobal":{"x":0, "y":0, "z":0}, "breakGroup":"craptech_jato_l"}],
        ["craptech_jato_out", "craptech_jato_rocket", "r6ll", "r6", "r3ll", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
            {"baseTranslationGlobal":{"x":0.3400, "y":2.1973, "z":0.4520}, "baseRotationGlobal":{"x":0, "y":0, "z":0}, "translationGlobal":{"x":0, "y":0.17, "z":0}, "breakGroup":"craptech_jato_l"}],
        ["craptech_jato_out", "craptech_jato_fire", "r6ll", "r6", "r3ll", {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1,
