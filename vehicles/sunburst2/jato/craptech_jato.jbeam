        ["cj_cl", "r6ll", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_cl", "r3", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_cl", "r6", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_cl", "r5ll", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_cl", "r2ll", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_ar", "cj_br", {"beamSpring":400000, "beamDamp":40, "beamDeform":"FLT_MAX", "beamStrength":"FLT_MAX", "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"", "deformGroup":""}],
        ["cj_ar", "cj_cr", {"beamSpring":400000, "beamDamp":40, "beamDeform":"FLT_MAX", "beamStrength":"FLT_MAX", "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"", "deformGroup":""}],
