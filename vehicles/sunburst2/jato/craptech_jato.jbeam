{
"craptech_jato_bumper": {
    "information":{
        "authors":"Crapouille Technologies",
        "name":"Crapouille Twin Bumper JATO",
        "value":24000,
    },
    //  Two solid-fuel boosters hidden in the rear bumper, one each side of the number plate.
    //  Deploying and firing are separate:
    //    Deploy / retract ("Crapouille JATO: deploy"): the painted panels part (upper half up, lower half
    //      down) and slide behind the bumper skin, then the rockets come out 17 cm on their rails (or the reverse).
    //    Fire / stop ("Crapouille JATO: fire", or the stock JATO key / app button): only once
    //      deployed. 2 x 6 kN, 8 s of burn in total, in as many bursts as you like. While they burn
    //      the rear wing goes flat. Fuel refills on vehicle reset.
    //  Logic: lua/controller/craptechJato.lua. Meshes: hatches/craptech_hatches.dae (doors follow
    //  the bumper skin and carry its paint mapping; rockets; flames).
    "slotType" : "craptech_jato",
    "controller": [
        ["fileName"],
        ["craptechJato", {"fuel":8, "thrustRampTime":0.15, "doorTime":0.5, "slideTime":3,
                          "nozzles":[["cj_al", "cj_bl"], ["cj_ar", "cj_br"]]}],
    ],
    //  every option inline: sections of all parts are merged, modifier rows would leak
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        //  per side: nozzle exit with the rocket out, a point down the exhaust, a side reference
        ["cj_al", 0.340, 2.367, 0.452, {"nodeWeight":2.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
        ["cj_bl", 0.340, 2.667, 0.452, {"nodeWeight":2.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
        ["cj_cl", 0.260, 2.367, 0.452, {"nodeWeight":2.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
        ["cj_ar", -0.340, 2.367, 0.452, {"nodeWeight":2.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
        ["cj_br", -0.340, 2.667, 0.452, {"nodeWeight":2.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
        ["cj_cr", -0.260, 2.367, 0.452, {"nodeWeight":2.0, "collision":false, "selfCollision":false, "group":"", "nodeMaterial":"|NM_METAL", "frictionCoef":0.5}],
    ],
    "beams": [
        ["id1:", "id2:"],
        //  tied to the rear panel and floor; each side breaks off on its own in a crash
        ["cj_al", "cj_bl", {"beamSpring":400000, "beamDamp":40, "beamDeform":"FLT_MAX", "beamStrength":"FLT_MAX", "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"", "deformGroup":""}],
        ["cj_al", "cj_cl", {"beamSpring":400000, "beamDamp":40, "beamDeform":"FLT_MAX", "beamStrength":"FLT_MAX", "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"", "deformGroup":""}],
        ["cj_bl", "cj_cl", {"beamSpring":400000, "beamDamp":40, "beamDeform":"FLT_MAX", "beamStrength":"FLT_MAX", "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"", "deformGroup":""}],
        ["cj_al", "r3ll", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_al", "r6ll", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_al", "r3", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_al", "r6", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_al", "r5ll", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_al", "r2ll", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_bl", "r3ll", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_bl", "r6ll", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_bl", "r3", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
        ["cj_bl", "r6", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_l", "deformGroup":""}],
