        ["cj_ar", "r6rr", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_ar", "r3", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
        ["cj_ar", "r6", {"beamSpring":400000, "beamDamp":40, "beamDeform":60000, "beamStrength":150000, "beamPrecompression":1, "beamType":"|NORMAL", "breakGroup":"craptech_jato_r", "deformGroup":""}],
